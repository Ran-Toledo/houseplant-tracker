# Copy to .env (next to compose.yaml) to override the defaults used by compose.yaml.
# .env is ignored by Git and Docker. The only secret is OPENAI_API_KEY; keep it out of this file.

# Host port for the web app (reachable from your local network).
WEB_PORT=5173

# Host port for direct API access (bound to 127.0.0.1 only). 3000 is often taken by other dev servers.
API_PORT=3001

# Maximum photo upload size in megabytes.
MAX_UPLOAD_MB=15

# OpenAI API key for AI features. Leave empty to turn them off. Passed to the api container only.
OPENAI_API_KEY=

# Model for AI features (default: gpt-5.4-mini). It must accept images.
# OPENAI_MODEL=gpt-5.4-mini

# How long to wait for an AI answer, in milliseconds.
# AI_TIMEOUT_MS=60000

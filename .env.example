# Copy to .env (next to compose.yaml) to override the defaults used by compose.yaml.
# .env is ignored by Git and Docker. The secrets are OPENAI_API_KEY and VAPID_PRIVATE_KEY; keep them out of this file.

# Host port for the web app (bound to 127.0.0.1 only; phones use the Tailscale HTTPS address). The container listens on 3000.
WEB_HOST_PORT=3020

# Host port for direct API access (bound to 127.0.0.1 only). The container listens on 8000.
API_HOST_PORT=8020

# Maximum photo upload size in megabytes.
MAX_UPLOAD_MB=15

# OpenAI API key for AI features. Leave empty to turn them off. Passed to the api container only.
OPENAI_API_KEY=

# Model for AI features (default: gpt-5.4-mini). It must accept images.
# OPENAI_MODEL=gpt-5.4-mini

# How long to wait for an AI answer, in milliseconds.
# AI_TIMEOUT_MS=60000

# Web Push for daily care notifications on the iPhone. Create them once with
#   npm run push:keys -w apps/api -- --subject mailto:you@example.com
# which appends these lines to .env. Leave them out to keep push off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# The app's HTTPS address for phones, shown in Settings → Notifications, e.g.
# APP_URL=https://my-pc.my-tailnet.ts.net
